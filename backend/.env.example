# Backend Configuration
SERVER_PORT=5000
NODE_ENV=development

# Email Configuration — Zoho Mail (mot de passe d'application, jamais le mot de passe du compte)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=contact@revyontech.com
SMTP_PASS=
SMTP_FROM=Revyon Tech <contact@revyontech.com>

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=contact@revyontech.com

# API Configuration
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=revyontech

# Admin access for protected endpoints
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=https://www.revyontech.com,https://revyontech.com,http://localhost:5173
